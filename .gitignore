!README.md
!CLAUDE.md
!AGENTS.md
!thinking-check-rubric.md
!settings.json

# Whitelisted directories (need both dir and contents)
!agents/
!agents/**
!plugins/
!plugins/local/
!plugins/local/**
!.claude-plugin/
!.claude-plugin/**
!scripts/
!scripts/**
!rules/
!rules/**
!docs/
!docs/skill-connections.md
!config/
!config/agentic/
!config/agentic/**
!tests/
!tests/**

# Runtime files never belong in this repository.
**/__pycache__/
config/agentic/**/.env*
config/agentic/**/secrets*

